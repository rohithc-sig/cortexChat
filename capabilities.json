{
  "dataRoles": [
    {
      "displayName": "Context Fields / Categories",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "User Email",
      "name": "userEmail",
      "kind": "Measure"
    },
    {
      "displayName": "User Region",
      "name": "userRegion",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "userEmail"
              }
            },
            {
              "for": {
                "in": "userRegion"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": [
        "https://cortexbackend.onrender.com",
        "http://localhost:8000"
      ]
    },
    {
      "name": "AADAuthentication",
      "essential": false
    }
  ]
}